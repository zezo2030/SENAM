# ──────────────────────────────────────────────────────────────────────────────
# SENAM — root compose env. Copy to .env and adjust:   cp .env.example .env
# Consumed by docker-compose.yml / docker-compose.dev.yml and the `api` service.
# Hostnames (postgres / redis / minio) are docker-compose service names.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_BASE_URL=http://localhost
LOG_LEVEL=info
# Host port the dashboard/nginx is published on (prod stack).
WEB_PORT=80

# ── Postgres (also used to build DATABASE_URL below) ───────────────────────────
POSTGRES_USER=senam
POSTGRES_PASSWORD=senam
POSTGRES_DB=senam
DATABASE_URL=postgresql://senam:senam@postgres:5432/senam
# TLS to Postgres. Leave false for the bundled container; set true for a
# managed cloud DB (e.g. RDS) that requires SSL.
DB_SSL=false

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379

# ── JWT (MUST be >= 64 chars in production) ────────────────────────────────────
JWT_SECRET=change_me_in_production_use_at_least_64_characters_long_secret_value
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ── OTP / dispatch / settlements ───────────────────────────────────────────────
OTP_RATE_LIMIT_ISSUE_PER_HOUR=3
OTP_RATE_LIMIT_VERIFY_ATTEMPTS=5
DISPATCH_ATTEMPT_TIMEOUT_MS=300000
DISPATCH_MAX_ATTEMPTS=3
SETTLEMENT_CRON=0 30 0 * * 0
CARRY_FORWARD_ALERT_THRESHOLD=10000

# ── Object storage (S3-compatible). Dev defaults target the MinIO container. ───
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=senam
S3_ACCESS_KEY_ID=senam
S3_SECRET_ACCESS_KEY=senam_secret
# S3_PUBLIC_BASE_URL=https://cdn.senam.qa

# ── Email ──────────────────────────────────────────────────────────────────────
# Dev: Mailhog container. Prod: set AWS SES creds instead.
MAIL_HOST=mailhog
MAIL_PORT=1025
AWS_SES_REGION=me-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=no-reply@senam.qa

# ── Payments (MyFatoorah) ──────────────────────────────────────────────────────
MYFATOORAH_API_KEY=
MYFATOORAH_SANDBOX=true
MYFATOORAH_WEBHOOK_SECRET=

# ── Dashboard build-time values (baked into the web image) ─────────────────────
VITE_DEFAULT_LOCALE=en
VITE_DEFAULT_TZ=Asia/Qatar
