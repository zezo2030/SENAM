# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
# Public URL clients use to reach this API (upload PUT + legacy absolute URLs).
# Prefer APP_BASE_URL; only set LOCAL_STORAGE_PUBLIC_BASE_URL when it must differ.
# API_PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://senam:senam@localhost:5432/senam

# Redis — use REDIS_ENABLED=false for local dev without Redis/Docker
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_SECRET=change_me_in_production_use_at_least_64_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# OTP
OTP_RATE_LIMIT_ISSUE_PER_HOUR=3
OTP_RATE_LIMIT_VERIFY_ATTEMPTS=5

# Dispatch
DISPATCH_ATTEMPT_TIMEOUT_MS=300000
DISPATCH_MAX_ATTEMPTS=3

# Settlements
SETTLEMENT_CRON=0 30 0 * * 0
CARRY_FORWARD_ALERT_THRESHOLD=10000

# MyFatoorah (Payment)
MYFATOORAH_API_KEY=your_api_key_here
MYFATOORAH_SANDBOX=true
MYFATOORAH_WEBHOOK_SECRET=your_webhook_secret_here

# Amazon SES (Email)
AWS_SES_REGION=me-south-1
AWS_SES_ACCESS_KEY_ID=your_access_key_here
AWS_SES_SECRET_ACCESS_KEY=your_secret_key_here
SES_FROM_ADDRESS=no-reply@senam.qa

# Mailhog (dev email sink — used when NODE_ENV=development)
MAIL_HOST=localhost
MAIL_PORT=1025

# Cloudflare R2 / S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=senam
S3_ACCESS_KEY_ID=senam
S3_SECRET_ACCESS_KEY=senam_secret
# Optional: public CDN base for uploaded objects (e.g. https://cdn.senam.qa).
# If unset, the API returns a path-style URL based on S3_ENDPOINT + bucket.
# S3_PUBLIC_BASE_URL=https://cdn.senam.qa

# Local filesystem storage (STORAGE_DRIVER=local)
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=./storage
# Stored image paths are host-independent (/v1/uploads/raw/...); this base is
# only for presigned PUT targets. Match where browsers reach the API.
# LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:3000
