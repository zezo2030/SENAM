# Use your dev machine's LAN IP so the phone can reach NestJS over Wi-Fi.
# Find it on Windows with `ipconfig` (look for IPv4 under your Wi-Fi adapter).
# Other targets if you switch later:
#   Android emulator: http://10.0.2.2:3000
#   iOS simulator:    http://localhost:3000
API_BASE_URL=http://192.168.1.10:3000
DEFAULT_LOCALE=ar
